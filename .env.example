# GEMINI_API_KEY: Required for default Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"


# Database Configuration (sqlite or postgres)
DB_TYPE="sqlite"
DB_FILE="./data/database.sqlite"
POSTGRES_URL="postgresql://user:password@localhost:5432/nexusai"

# Application Settings
PORT=3000
JWT_SECRET="nexus_llm_secret_key_2026_super_secure"
DEFAULT_ADMIN_EMAIL="admin@nexusai.io"
DEFAULT_ADMIN_PASSWORD="admin123"
