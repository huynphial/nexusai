# Environment Mode (development or production)
NODE_ENV="development"

# Enable Detailed Debug Logging for API Calls & Audit Traces (true or false)
DEBUG_LOG="true"

# Default Admin Account Credentials
DEFAULT_ADMIN_EMAIL="admin@localai.internal"
DEFAULT_ADMIN_PASSWORD="admin123"

# Database Configuration (sqlite or postgres)
DB_TYPE="sqlite"
DB_FILE="./data/database.sqlite"

# Application Server & Security
PORT=3000
JWT_SECRET="local_ai_secret_key_2026_super_secure"

# Optional Gemini API Key & App URL
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Application Branding & UI Copy
VITE_APP_NAME="Local AI"
VITE_APP_TITLE="Local AI"
VITE_APP_GREETING="Chào mừng bạn đến với Local AI"
VITE_APP_DESCRIPTION="Trợ lý trí tuệ nhân tạo hỗ trợ streaming thời gian thực, hiển thị quá trình suy luận (Thinking) và đo lường hiệu năng tốc độ xử lý token chi tiết."

