# Environment Mode (development or production)
NODE_ENV="development"

# Enable Detailed Debug Logging for API Calls & Audit Traces (true or false)
DEBUG_LOG="true"

# Default Admin Account Credentials
DEFAULT_ADMIN_EMAIL="admin@nexusai.io"
DEFAULT_ADMIN_PASSWORD="admin123"

# Database Configuration (sqlite or postgres)
DB_TYPE="sqlite"
DB_FILE="./data/database.sqlite"

# Application Server & Security
PORT=3000
JWT_SECRET="nexus_llm_secret_key_2026_super_secure"

# Optional Gemini API Key & App URL
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
